{
  "name": "flightsure",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.17.0 <25"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env server/index.ts",
    "typecheck": "tsc --noEmit",
    "db:start": "docker compose up -d --wait",
    "db:stop": "docker compose stop",
    "db:migrate": "tsx --env-file=.env database/migrate.ts",
    "db:seed": "tsx --env-file=.env database/seed.ts",
    "db:shell": "docker compose exec postgres psql -U flightsure -d flightsure"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "express": "^5.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
