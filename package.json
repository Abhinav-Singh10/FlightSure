{
  "name": "flightsure",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.17.0 <25"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env server/index.ts",
    "typecheck": "tsc --noEmit",
    "db:start": "docker compose up -d --wait",
    "db:stop": "docker compose stop",
    "db:migrate": "tsx --env-file=.env database/migrate.ts",
    "db:seed": "tsx --env-file=.env database/seed.ts",
    "db:shell": "docker compose exec postgres psql -U flightsure -d flightsure",
    "web": "vite",
    "test": "node --env-file=.env --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "build": "vite build"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jest": "^30.5.2",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.15",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
