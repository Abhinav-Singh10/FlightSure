# Copy this file to .env if you do not already have one.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://flightsure:flightsure_dev@localhost:5432/flightsure
# Keep your existing private secrets if already configured.
JWT_SECRET=flightsure-local-jwt-secret-change-this
TEST_DATABASE_URL=postgresql://flightsure:flightsure_dev@localhost:5432/flightsure_test
# Local development admin only. Passengers will register through the application.
SEED_ADMIN_EMAIL=admin@flightsure.test
SEED_ADMIN_PASSWORD=AdminDemo123!
# Optional: set a future YYYY-MM-DD date for repeatable demonstrations.
# When omitted, seeds begin tomorrow in IST.
# SEED_START_DATE=2026-11-01
